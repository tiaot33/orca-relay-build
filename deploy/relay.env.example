# LXC 内监听端口（由外部 Caddy 反代到此端口）
PORT=8080
NODE_ENV=production

# 单实例混合模式（同时担任 director 调度与 cell WebSocket 转发）
ORCA_RELAY_ROLE=combined
ORCA_RELAY_DATA_DIR=/var/lib/orca-relay

# 对外暴露的 Caddy HTTPS Origin（严禁末尾斜杠 / 或子路径；非 443 端口需写全如 https://relay.example.com:8443）
ORCA_RELAY_PUBLIC_URL=https://relay.yourdomain.com
ORCA_RELAY_CELL_URL=https://relay.yourdomain.com

# 至少 32 字节的随机密钥（请用 `openssl rand -base64 32` 生成替换）
ORCA_RELAY_ASSIGNMENT_SIGNING_KEY=CHANGE_ME_WITH_AT_LEAST_32_BYTES_RANDOM_SECRET

# 管理接口占位配置（单机自建无需调用，但必须满足 URL / Email 校验）
ORCA_RELAY_ADMIN_AUDIENCE=https://relay.yourdomain.com/v1/admin
ORCA_RELAY_DEPLOY_SERVICE_ACCOUNT=admin@relay.local

# 桌面端 Relay Token 验签配置
ORCA_RELAY_AUTH_ISSUER=https://login.onorca.dev
ORCA_RELAY_JWKS_URL=https://login.onorca.dev/.well-known/jwks.json
